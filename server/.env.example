NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://buenprecio:buenprecio_dev@localhost:5432/buenprecio
JWT_SECRET=dev-secret-change-me

# Admin inicial (seed:admin)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@buenprecio.app
ADMIN_PASSWORD=admin-cambiar-123

# Vercel Blob (opcional: si está definido, los uploads van al Blob en vez de disco)
BLOB_READ_WRITE_TOKEN=

# Soporte de la SPA (opcional): directorio con el index.html del web para SEO
SPA_DIR=

# URL pública para SEO (canonical/og). Por defecto https://buenprecio.onrender.com
SITE_URL=

# Google Sign-In (Client ID de OAuth 2.0 tipo Web)
GOOGLE_CLIENT_ID=